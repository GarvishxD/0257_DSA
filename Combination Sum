class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res = new ArrayList<>();
        sum(res,new ArrayList<>(),0,candidates,target);
        return res;
            }
     void sum(List<List<Integer>> res , List<Integer> store , int index , int []candidates , int target){
        if(target == 0) res.add(new ArrayList<>(store));
        if(target < 0 ) return;
        else{
            for(int i = index ; i<candidates.length ; i++){
                store.add(candidates[i]);
                sum(res,store,i,candidates,target-candidates[i]);
                store.remove(store.size()-1);
            }
        }

    }
}
